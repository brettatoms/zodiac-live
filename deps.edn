{:paths ["src"]
 ;; The zodiac wiring, and nothing else. Integrant keys, routes and request-context
 ;; injection — no domain logic, following zodiac-hot-reload's shape. If this grows
 ;; past wiring, the map-of-pieces design has failed.
 ;;
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        com.github.brettatoms/darkstar {:mvn/version "0.1.9"}
        com.github.brettatoms/zodiac {:mvn/version "1.0.119"}
        integrant/integrant {:mvn/version "1.0.1"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}}

 :aliases {;; The encrypted chat example: SQLite via the Source protocol, a key that
           ;; never reaches the server, and typing indicators over PubSub hints.
           ;; Lives here rather than in darkstar because it is a *zodiac* app —
           ;; it exercises this extension's integrant wiring and request context.
           :example {:extra-paths ["examples" "examples/resources"]
                     :extra-deps {com.github.brettatoms/zodiac-sql {:mvn/version "0.3.27"}
                                  dev.data-star.clojure/ring {:mvn/version "1.0.0-RC11"}
                                  dev.onionpancakes/chassis {:mvn/version "1.0.365"}
                                  com.cnuernber/charred {:mvn/version "1.041"}
                                  org.xerial/sqlite-jdbc {:mvn/version "3.53.2.1"}
                                  com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}}
                     :jvm-opts ["-XX:-OmitStackTraceInFastThrow"]}

           :test {:extra-paths ["test"]
                  :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                  :main-opts ["-m" "kaocha.runner"]}

           ;; The CONTROL EXPERIMENT: the same app on the same stack, using Datastar
           ;; directly instead of darkstar. Same zodiac, same zodiac-sql, so the only
           ;; variable is the engine.
           ;;
           ;;   clojure -M:direct -m direct.server   (port 3001)
           :direct {:extra-paths ["examples" "examples/resources"]
                    :extra-deps {com.github.brettatoms/zodiac-sql {:mvn/version "0.3.27"}
                                 dev.data-star.clojure/ring {:mvn/version "1.0.0-RC11"}
                                 dev.onionpancakes/chassis {:mvn/version "1.0.365"}
                                 com.cnuernber/charred {:mvn/version "1.041"}
                                 org.xerial/sqlite-jdbc {:mvn/version "3.53.2.1"}
                                 com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}}
                    :jvm-opts ["-XX:-OmitStackTraceInFastThrow"]}

           ;; A browser test for darkstar.watch. Roster only, bare jetty, no zodiac
           ;; and no extension — see examples/watchspike/server.clj for why.
           ;;
           ;;   clojure -M:dev:watchspike -m watchspike.server   (port 3002)
           :watchspike {:extra-paths ["examples" "examples/resources"]
                        :extra-deps {dev.data-star.clojure/ring {:mvn/version "1.0.0-RC11"}
                                     dev.onionpancakes/chassis {:mvn/version "1.0.365"}
                                     ring/ring-jetty-adapter {:mvn/version "1.14.2"}}
                        :jvm-opts ["-XX:-OmitStackTraceInFastThrow"]}

           ;; The build dashboard: 1 writer, N readers, with sibling fragments whose
           ;; update rates differ by ~100x. Tests fan-out and pruning where a chat app
           ;; cannot — see examples/dash/jobs.clj.
           ;;
           ;;   clojure -M:dev:dash -m dash.server   (port 3004)
           :dash {:extra-paths ["examples" "examples/resources"]
                  :extra-deps {com.cnuernber/charred {:mvn/version "1.041"}
                               dev.data-star.clojure/ring {:mvn/version "1.0.0-RC11"}
                               dev.onionpancakes/chassis {:mvn/version "1.0.365"}
                               ring/ring-jetty-adapter {:mvn/version "1.14.2"}}
                  :jvm-opts ["-XX:-OmitStackTraceInFastThrow"]}

           ;; clojure -M:dev:... — resolve sibling libraries from the working tree
           ;; rather than a released version. See darkstar's :dev alias.
           :dev {:override-deps {com.github.brettatoms/darkstar {:local/root "../darkstar"}}}

           ;; clojure -T:build jar | deploy
           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                          slipset/deps-deploy {:mvn/version "0.2.5"}}
                   :ns-default build}

           :clj-kondo {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.05.25"}}
                       :main-opts ["-m" "clj-kondo.main"]}

           :cljfmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
                    :main-opts ["-m" "cljfmt.main"]}}}
